APP_NAME="JS Designs API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jsdesign
DB_USERNAME=jsdesign
DB_PASSWORD=jsdesign

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=jsdesign

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PROMO_FIRST_PURCHASE_ENABLED=false
PROMO_FIRST_PURCHASE_DELIVERY=email
PROMO_FIRST_PURCHASE_PERCENT=10
PROMO_FIRST_PURCHASE_MINIMUM_AMOUNT=
PROMO_FIRST_PURCHASE_NON_CUMULATIVE=true
PROMO_FIRST_PURCHASE_MANUAL_CHECKOUT_REQUIRED=true
PROMO_FIRST_PURCHASE_AUTHORIZATION_TEXT_VERSION=coupon-v1
PROMO_FIRST_PURCHASE_LEGAL_BASIS=
PROMO_FIRST_PURCHASE_RETENTION_POLICY_VERSION=
PROMO_FIRST_PURCHASE_REAL_DATA_ALLOWED=false
PROMO_FIRST_PURCHASE_PRIVACY_PUBLISHED=false
PROMO_FIRST_PURCHASE_PROVIDER_READY=false
PROMO_FIRST_PURCHASE_WORKER_REQUIRED=true
PROMO_FIRST_PURCHASE_WORKER_READY=false
PROMO_FIRST_PURCHASE_TEST_DISPLAY_ALLOWED=false
PROMO_FIRST_PURCHASE_TEST_ENVIRONMENT=false
TRUSTED_PROXIES=127.0.0.1,::1
PROMO_FIRST_PURCHASE_IP_LIMIT_PER_MINUTE=5
PROMO_FIRST_PURCHASE_EMAIL_LIMIT_PER_HOUR=3
PROMO_FIRST_PURCHASE_HMAC_KEY_VERSION=v1
PROMO_FIRST_PURCHASE_HMAC_KEY=
PROMO_FIRST_PURCHASE_ENCRYPTION_KEY_VERSION=v1
PROMO_FIRST_PURCHASE_ENCRYPTION_KEY=
PROMO_FIRST_PURCHASE_MAIL_TEMPLATE_VERSION=first-purchase-v1
PROMO_FIRST_PURCHASE_PRIVACY_URL=/privacidade

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
